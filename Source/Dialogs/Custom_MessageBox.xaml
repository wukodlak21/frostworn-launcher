<UserControl x:Class="Oracle_Lite.Dialogs.Custom_MessageBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oracle_Lite.Dialogs"
             mc:Ignorable="d" FontFamily="Philosopher" FontWeight="Bold"
             Foreground="Black">
    <Border CornerRadius="5" Background="#3F000000">
        <Grid>
            <Border CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" MaxWidth="500" Background="#FFF2F5FA" Padding="35,30,35,30">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleHolder" FontSize="20" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" Margin="0,0,0,12"/>
                    <TextBlock x:Name="MessageHolder" FontSize="15" FontWeight="Normal" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="430"/>
                    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Center">
                        <Button x:Name="ButtonYes" Content="Yes" Style="{DynamicResource ButtonStyle3}" Click="ButtonYes_Click"/>
                        <Button x:Name="ButtonOK" Content="OK" Style="{DynamicResource ButtonStyle3}" Click="ButtonOK_Click"/>
                        <Button x:Name="ButtonNo" Content="No" Style="{DynamicResource ButtonStyle4}" Margin="10,0,0,0" Click="ButtonNo_Click"/>
                        <Button x:Name="ButtonCancel" Content="Cancel" Style="{DynamicResource ButtonStyle4}" Margin="10,0,0,0" Click="ButtonCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
